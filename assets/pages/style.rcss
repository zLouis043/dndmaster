* {
    font-family: Roboto;
}

body {
    width: 100%;
    height: 100%;
    /* Flexbox funziona perfettamente! */
    display: flex;
    justify-content: center;
    align-items: center;
}

#character-card {
    display: block;
    width: 400px;
    padding: 30px;
    background-color: #2c3e50;
    color: white;
    border-radius: 15px;
    border: 2px #34495e;
    box-shadow: 0px 10px 20px rgba(0, 0, 0, 150);
}

h1 {
    font-size: 32px;
    margin-bottom: 15px;
    color: #e67e22;
}

p {
    font-size: 30px;
    line-height: 1.4;
    margin-bottom: 20px;
    color: #fff;
    font-effect: outline(1px #0000007f);
}

.stats {
    display: flex;
    justify-content: space-around;
    margin-bottom: 30px;
}

.stat-box {
    background-color: #34495e;
    padding: 10px 20px;
    border-radius: 10px;
    text-align: center;
    font-size: 20px;
}

button {
    display: block;
    width: 100%;
    padding: 15px;
    background-color: #e74c3c;
    color: white;
    font-size: 20px;
    font-weight: bold;
    border-radius: 8px;
    text-align: center;
}

button:hover {
    background-color: #c0392b;
}

/* Contenitori per le schermate a tutto schermo */
.panel-container {
    width: 80%; height: 80%;
    background: #2c3e50; border: 2px #e67e22; border-radius: 10px;
    display: flex; flex-direction: column;
}

/* Sistema a Tab */
.tab-bar { display: flex; background: #1a252f; border-top-left-radius: 8px; border-top-right-radius: 8px; }
.tab-btn { flex-grow: 1; padding: 15px; background: transparent; color: #bdc3c7; border: none; font-size: 20px; }
.tab-btn:hover { background: #34495e; color: white; }
.tab-btn.active { background: #e67e22; color: white; font-weight: bold; }

.tab-content { flex-grow: 1; padding: 20px; overflow-y: auto; }

/* Liste Dinamiche */
.list-item { 
    display: block; width: 100%; padding: 15px; margin-bottom: 5px;
    background: #34495e; color: white; text-align: left; border: 1px #4b6584; 
}
.list-item:hover { background: #415b76; border-color: #e67e22; }

/* Form e Input */
.form-row { display: flex; margin-bottom: 15px; align-items: center; }
.form-row label { width: 150px; color: #bdc3c7; font-size: 18px; }
.form-row input { flex-grow: 1; padding: 10px; background: #1a252f; color: white; border: 1px #7f8c8d; font-size: 18px; }

.stats-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.stat-box { width: 45%; display: flex; margin-bottom: 15px; align-items: center; }
.stat-box label { width: 120px; color: #e67e22; font-weight: bold; }
.stat-box input { width: 80px; padding: 10px; text-align: center; background: #1a252f; color: white; border: 1px #7f8c8d; font-size: 18px; }