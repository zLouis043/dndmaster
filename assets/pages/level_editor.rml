<rml>
<head>
    <link type="text/rcss" href="style.rcss"/>
    <style>
        body { width: 100%; height: 100%; margin: 0; font-family: Lato; pointer-events: none;}
        
        #map_canvas { 
            display: block; position: absolute; top: 0; left: 0; 
            width: 100%; height: 100%; z-index: 0; 
            pointer-events: auto;
        }

        #properties_bar {
            position: absolute; top: 0; left: 0; width: 100%; height: 50px;
            background: #1e272e; border-bottom: 2px solid #e67e22; z-index: 20;
            display: flex; align-items: center; padding-left: 250px;
        }

        #tools {
            position: absolute; left: 0; top: 50px; width: 230px; bottom: 0;
            background: #2c3e50; padding: 15px; z-index: 10;
            box-sizing: border-box; border-right: 2px solid #34495e;
        }

        #properties_bar, #tools { pointer-events: auto; }

        /* Stili per l'AutoInspector */
        .prop-row { margin-right: 20px; display: flex; align-items: center; color: white; }
        .inspector-group { display: flex; align-items: center; }
        .inspector-group-title { margin-right: 15px; font-weight: bold; color: #e67e22; }

        .tool-btn { 
            margin-bottom: 5px; display: block; width: 100%; padding: 8px; 
            cursor: pointer; background: #34495e; border: 1px solid #2c3e50; color: white;
        }
        .tool-btn.active { background-color: #e67e22; color: white; }
        .tool-btn:hover { background-color: #f39c12; }

        input[type="range"] { display: inline-block; width: 120px; height: 20px; }
        input[type="range"] slidertrack { background: #34495e; height: 6px; margin-top: 7px; border: 1px solid #2c3e50; }
        input[type="range"] sliderbar { width: 14px; height: 20px; background: #e67e22; cursor: pointer; }
        input[type="range"] sliderbar:hover { background: #f39c12; }
    </style>
</head>
<body>
    <div id="properties_bar" data-block="true">
        <div id="tool-settings" style="display: flex;"></div>
    </div>
    
    <skia-canvas id="map_canvas"></skia-canvas>
    
    <div id="tools" style="top: 50px;" data-block="true">
        <h2 style="color: #e67e22; margin-bottom: 10px;">Dungeon Editor</h2>
        
        <div id="tool_list"></div>

        <hr style="margin: 15px 0; border-color: #7f8c8d;" />
        
        <button id="btn_save" style="background: #27ae60;">Salva Mappa</button>
        <button id="btn_reset" style="background: #e67e22; margin-bottom: 25px;">Reset Mappa</button>
        
        <button id="btn_exit" style="background: #c0392b;">Torna all'Hub</button>
    </div>
</body>
</rml>