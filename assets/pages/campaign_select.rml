<rml>
<head>
    <link type="text/rcss" href="style.rcss"/>
    <style>
        .container {
            width: 500px; padding: 40px;
            background: #2c3e50; border: 2px #e67e22; border-radius: 15px;
            text-align: center; color: white; margin: auto;
        }
        h1 { font-size: 30px; color: #e67e22; margin-bottom: 25px; }
        
        .prop-row { display: flex; flex-direction: column; text-align: left; margin-bottom: 25px; }
        .prop-row label { margin-bottom: 10px; font-size: 18px; color: #bdc3c7;}
        input { padding: 10px; background: #34495e; border: 1px #7f8c8d; color: white; font-size: 20px; width: 100%; box-sizing: border-box;}
        
        .action-row { margin-bottom: 10px; }
        button { display: block; width: 100%; padding: 15px; color: white; font-weight: bold; border: none; cursor: pointer; font-size: 18px;}
        button.btn-primary { background: #e67e22; }
        button.btn-primary:hover { background: #d35400; }
        button.btn-secondary { background: #7f8c8d; margin-top: 15px;}
        button.btn-secondary:hover { background: #95a5a6; }
    </style>
</head>
<body>
    <div style="width: 100%; height: 100%; display: flex; justify-content: center; align-items: center;">
        <div class="container">
            <h1>GESTIONE CAMPAGNE</h1>
            <div id="form_container"></div>
        </div>
    </div>
</body>
</rml>