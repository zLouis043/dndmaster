<rml>
<head>
    <link type="text/rcss" href="style.rcss"/>
    <style>
        body {
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #1a1a1a;
        }
        .container {
            width: 400px;
            padding: 40px;
            background: #2c3e50;
            border: 2px #e67e22;
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        h1 { 
            font-size: 28px; 
            color: #e67e22; 
            margin-bottom: 20px;
            width: 100%;
        }
        #status { 
            color: #bdc3c7; 
            margin-bottom: 20px; 
            font-size: 16px;
        }
        #code_container {
            display: none;
            width: 100%;
            margin-bottom: 20px;
        }
        #session_code {
            font-size: 32px;
            color: #e67e22;
            background: #1a1a1a;
            padding: 15px;
            border-radius: 6px;
            width: 100%;
            margin-bottom: 10px;
        }
        .hint {
            color: #7f8c8d;
            font-size: 13px;
            margin-bottom: 20px;
        }
        button {
            width: 100%;
            padding: 12px;
            background: #34495e;
            color: white;
            border: 1px #4b6584;
            font-size: 16px;
        }
        button:hover { background: #e67e22; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Apri Sessione Online</h1>
        <p id="status">Apertura sessione in corso...</p>
        <div id="code_container">
            <p id="session_code"></p>
            <p class="hint">Condividi questo codice con i tuoi giocatori</p>
        </div>
        <button id="btn_back">Torna al Menu</button>
    </div>
</body>
</rml>