<rml>
<head>
    <link type="text/rcss" href="style.rcss"/>
    <style>
        body {
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #1a1a1a;
        }
        .container {
            width: 400px;
            padding: 40px;
            background: #2c3e50;
            border: 2px #e67e22;
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        h1 { 
            font-size: 28px; 
            color: #e67e22; 
            margin-bottom: 20px;
            width: 100%;
        }
        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            background: #1a1a1a;
            color: white;
            border: 1px #4b6584;
            font-size: 20px;
            text-align: center;
        }
        #status { 
            color: #bdc3c7; 
            margin-bottom: 15px;
            font-size: 14px;
            min-height: 20px;
        }
        button {
            width: 100%;
            padding: 12px;
            margin-bottom: 10px;
            background: #34495e;
            color: white;
            border: 1px #4b6584;
            font-size: 16px;
        }
        button:hover { background: #e67e22; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Unisciti a Sessione</h1>
        <input id="input_code" type="text" placeholder="Inserisci codice sessione"/>
        <p id="status"></p>
        <button id="btn_join">Connetti</button>
        <button id="btn_back">Torna al Menu</button>
    </div>
</body>
</rml>