<div id="cp_popup" style="display: block; position: absolute; top: 30px; left: 0; width: 160px; background: #2c3e50; border: 2px solid #34495e; padding: 10px; z-index: 1000;">
    
    <div style="display: block; margin-bottom: 5px;">
        <span style="display: inline-block; width: 15px; color: #e74c3c; font-weight: bold; vertical-align: middle;">R</span> 
        <input type="range" id="cp_r" min="0" max="255" step="1" style="display: inline-block; width: 120px; vertical-align: middle;" />
    </div>
    
    <div style="display: block; margin-bottom: 5px;">
        <span style="display: inline-block; width: 15px; color: #2ecc71; font-weight: bold; vertical-align: middle;">G</span> 
        <input type="range" id="cp_g" min="0" max="255" step="1" style="display: inline-block; width: 120px; vertical-align: middle;" />
    </div>
    
    <div style="display: block;">
        <span style="display: inline-block; width: 15px; color: #3498db; font-weight: bold; vertical-align: middle;">B</span> 
        <input type="range" id="cp_b" min="0" max="255" step="1" style="display: inline-block; width: 120px; vertical-align: middle;" />
    </div>

</div>